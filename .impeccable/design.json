      "html": "<label class=\"ds-search\"><span class=\"ds-mark\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"><path d=\"M12 3 21 7.5 12 12 3 7.5Z\" fill=\"currentColor\" fill-opacity=\".35\"/><path d=\"m3 12 9 4.5 9-4.5\"/><path d=\"m3 16.5 9 4.5 9-4.5\"/></svg></span><input placeholder=\"Search rooms, clubs, offices\"></label>",
